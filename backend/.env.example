CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_DIR=logs
JOB_TTL_SECONDS=3600
MAX_RETAINED_JOBS=100
DATABASE_PATH=data/scanner_crypto.sqlite3
CANDLE_STORAGE_ENABLED=true
CANDLE_SYNC_ENABLED=true
CANDLE_DEFAULT_LIMIT=500
CANDLE_MAX_API_LIMIT=5000
CANDLE_INDICATOR_WARMUP_BARS=500
CANDLE_GAP_REPAIR_ENABLED=true
CANDLE_SYNC_PAGE_LIMIT=1000
CANDLE_SYNC_MAX_PAGES=100
CANDLE_OPEN_WRITE_INTERVAL_SECONDS=5
MARKET_HISTORY_WINDOW_BEFORE=500
MARKET_HISTORY_WINDOW_AFTER=500
BACKFILL_DEFAULT_EXCHANGE=binance
BACKFILL_DEFAULT_MARKET_TYPE=spot
BACKFILL_DEFAULT_QUOTE=USDC
BACKFILL_DEFAULT_TIMEFRAMES=1m,3m,5m,15m,30m,1h,2h,4h,6h,8h,12h,1d,3d,1w
BACKFILL_PAGE_LIMIT=1000
BACKFILL_MAX_CONCURRENCY=2
BACKFILL_MAX_RETRIES=5
BACKFILL_RETRY_DELAY_SECONDS=2
BACKFILL_PROGRESS_INTERVAL_SECONDS=5
BACKFILL_OVERLAP_CANDLES=2
BACKFILL_REPAIR_GAPS=true
BINANCE_SYMBOL=BTC/USDC
BINANCE_TIMEFRAME=1h
CALCULATION_LIMIT=500
DISPLAY_LIMIT=500
DIVERGENCE_LEFT=3
DIVERGENCE_RIGHT=3
DIVERGENCE_MIN_BARS=5
DIVERGENCE_MAX_BARS=60
DIVERGENCE_PRICE_MIN_CHANGE=0.001
INCLUDE_HIDDEN_DIVERGENCES=true

# Comparaison de profils uniquement; aucune exécution ni influence sur la production.
SHADOW_MODE_ENABLED=false
