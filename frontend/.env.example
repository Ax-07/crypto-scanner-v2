# URL HTTP FastAPI (REST et fallback WebSocket si VITE_WS_URL est absent).
VITE_API_URL=http://127.0.0.1:8000
# Origine WebSocket sans le chemin /ws.
VITE_WS_URL=ws://127.0.0.1:8000
VITE_MARKET_INITIAL_CANDLE_LIMIT=2000
VITE_MARKET_HISTORY_PAGE_LIMIT=2000
VITE_MARKET_HISTORY_WINDOW_BEFORE=500
VITE_MARKET_HISTORY_WINDOW_AFTER=500
VITE_MARKET_PREFETCH_THRESHOLD_BARS=100
# 0 conserve tout l'historique chargé. Une valeur positive borne la fenêtre en mémoire.
VITE_MARKET_MAX_CANDLES_IN_MEMORY=0
